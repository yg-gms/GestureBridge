{
  "manifest_version": 3,
  "name": "GestureBridge — Custom gestures for Slides",
  "version": "0.2.0",
  "description": "Teach your own hand poses to control Google Slides, with one setup saved locally.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "action": { "default_title": "Open GestureBridge" },
  "side_panel": { "default_path": "extension/index.html" },
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
